<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestorTrabajo">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RegistroActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Cliente y trabajador -->
        <activity
            android:name=".PerfilActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity android:name=".MensajesActivity" />
        <activity
            android:name=".ConversacionActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".SeguimientoActivity" />
        <activity
            android:name=".CalificarActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Administrador -->
        <activity android:name=".AdminCatalogosActivity" />
        <activity
            android:name=".AdminUsuariosActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Cliente -->
        <activity android:name=".MisSolicitudesActivity" />
        <activity
            android:name=".NuevaSolicitudActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".DetalleSolicitudActivity" />
        <activity android:name=".PropuestasActivity" />

        <!-- Trabajador -->
        <activity android:name=".TrabajosZonaActivity" />
        <activity
            android:name=".DetalleTrabajoActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".MisPropuestasActivity" />
    </application>

</manifest>
