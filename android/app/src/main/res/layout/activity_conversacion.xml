<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:orientation="vertical">

    <LinearLayout style="@style/BarraSuperior">

        <ImageButton
            android:id="@+id/btnVolver"
            style="@style/BotonIcono"
            android:contentDescription="@string/volver"
            android:onClick="volver"
            android:src="@drawable/ic_atras" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_pequeno"
            android:paddingBottom="@dimen/espacio_pequeno">

            <TextView
                android:id="@+id/txtNombre"
                style="@style/TituloBarra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtTrabajo"
                style="@style/SubtituloBarra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnActualizar"
            style="@style/BotonIcono"
            android:contentDescription="@string/actualizar"
            android:onClick="actualizar"
            android:src="@drawable/ic_refrescar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo">

        <ListView
            android:id="@+id/listaMensajes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="@dimen/espacio_pequeno"
            android:padding="@dimen/espacio_pantalla"
            android:transcriptMode="normal" />

        <TextView
            android:id="@+id/txtVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/espacio_pantalla"
            android:text="@string/cargando"
            android:textColor="@color/gris"
            android:textSize="@dimen/texto_subtitulo" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtCerrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:gravity="center"
        android:padding="@dimen/espacio_medio"
        android:text="@string/conversacion_cerrada"
        android:textColor="@color/gris"
        android:textSize="@dimen/texto_normal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/vistaEscribir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_pequeno">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_mensaje_chat">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="1000"
                android:maxLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/btnEnviar"
            style="@style/BotonIcono"
            android:contentDescription="@string/enviar_mensaje"
            android:onClick="enviar"
            android:src="@drawable/ic_enviar"
            app:tint="@color/principal" />
    </LinearLayout>
</LinearLayout>
