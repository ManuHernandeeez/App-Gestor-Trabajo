<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:orientation="vertical">

    <LinearLayout style="@style/BarraSuperior">

        <ImageButton
            android:id="@+id/btnVolver"
            style="@style/BotonIcono"
            android:contentDescription="@string/volver"
            android:onClick="volver"
            android:src="@drawable/ic_atras" />

        <TextView
            android:id="@+id/txtTituloBarra"
            style="@style/TituloBarra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/titulo_detalle_solicitud" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_pantalla">

            <TextView
                android:id="@+id/txtCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/espacio_pantalla"
                android:text="@string/cargando"
                android:textColor="@color/gris"
                android:textSize="@dimen/texto_subtitulo" />

            <LinearLayout
                android:id="@+id/vistaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_tarjeta">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espacio_pequeno"
                            android:layout_weight="1"
                            android:textColor="@color/texto"
                            android:textSize="@dimen/texto_titulo"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtEstado"
                            style="@style/EtiquetaEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtOficio"
                        style="@style/FilaIcono"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:drawableStart="@drawable/ic_fila_oficio" />

                    <TextView
                        android:id="@+id/txtZona"
                        style="@style/FilaIcono"
                        android:drawableStart="@drawable/ic_fila_ubicacion" />

                    <TextView
                        android:id="@+id/txtTrabajador"
                        style="@style/FilaIcono"
                        android:drawableStart="@drawable/ic_fila_persona"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtPresupuesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:background="@drawable/fondo_precio"
                        android:padding="@dimen/espacio_medio"
                        android:textColor="@color/principal_oscuro"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPropuestas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_seccion"
                    android:onClick="verPropuestas"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSeguimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_seccion"
                    android:onClick="verSeguimiento"
                    android:text="@string/boton_ver_seguimiento"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnCancelar"
                    style="@style/BotonPeligro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio"
                    android:onClick="cancelarSolicitud"
                    android:text="@string/boton_cancelar_solicitud"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
