<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:orientation="vertical">

    <LinearLayout style="@style/BarraSuperior">

        <ImageButton
            android:id="@+id/btnVolver"
            style="@style/BotonIcono"
            android:contentDescription="@string/volver"
            android:onClick="volver"
            android:src="@drawable/ic_atras" />

        <TextView
            android:id="@+id/txtTituloBarra"
            style="@style/TituloBarra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/titulo_detalle_trabajo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_pantalla">

            <TextView
                android:id="@+id/txtCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/espacio_pantalla"
                android:text="@string/cargando"
                android:textColor="@color/gris"
                android:textSize="@dimen/texto_subtitulo" />

            <LinearLayout
                android:id="@+id/vistaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_tarjeta">

                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_titulo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOficio"
                        style="@style/FilaIcono"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:drawableStart="@drawable/ic_fila_oficio" />

                    <TextView
                        android:id="@+id/txtZona"
                        style="@style/FilaIcono"
                        android:drawableStart="@drawable/ic_fila_ubicacion" />

                    <TextView
                        android:id="@+id/txtCliente"
                        style="@style/FilaIcono"
                        android:drawableStart="@drawable/ic_fila_persona" />

                    <TextView
                        android:id="@+id/txtPresupuesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:background="@drawable/fondo_precio"
                        android:padding="@dimen/espacio_medio"
                        android:textColor="@color/principal_oscuro"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio"
                    android:background="@drawable/fondo_aviso"
                    android:padding="@dimen/espacio_medio"
                    android:text="@string/aviso_contacto"
                    android:textColor="@color/aviso_texto"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/txtMiPropuesta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio"
                    android:background="@drawable/fondo_tarjeta"
                    android:padding="@dimen/espacio_tarjeta"
                    android:textColor="@color/texto"
                    android:textSize="@dimen/texto_subtitulo"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/vistaFormulario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_seccion"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/espacio_medio"
                        android:text="@string/tu_propuesta"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_precio"
                        app:prefixText="$">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPrecio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:hint="@string/hint_mensaje"
                        app:counterEnabled="true"
                        app:counterMaxLength="300">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtMensaje"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="300"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnEnviar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:onClick="enviar"
                        android:text="@string/boton_enviar_propuesta" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
