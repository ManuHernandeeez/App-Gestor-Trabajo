<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:orientation="vertical">

    <LinearLayout style="@style/BarraSuperior">

        <ImageButton
            android:id="@+id/btnVolver"
            style="@style/BotonIcono"
            android:contentDescription="@string/volver"
            android:onClick="volver"
            android:src="@drawable/ic_atras" />

        <TextView
            android:id="@+id/txtTituloBarra"
            style="@style/TituloBarra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/titulo_propuestas" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_pantalla"
            android:layout_marginTop="@dimen/espacio_pantalla"
            android:layout_marginEnd="@dimen/espacio_pantalla"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="@dimen/espacio_tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_pequeno"
                    android:layout_weight="1"
                    android:textColor="@color/texto"
                    android:textSize="@dimen/texto_subtitulo"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEstado"
                    style="@style/EtiquetaEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtZona"
                style="@style/FilaIcono"
                android:drawableStart="@drawable/ic_fila_ubicacion" />

            <TextView
                android:id="@+id/txtPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_pequeno"
                android:textColor="@color/principal"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtIndicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/espacio_pantalla"
            android:paddingTop="@dimen/espacio_medio"
            android:paddingEnd="@dimen/espacio_pantalla"
            android:textColor="@color/gris"
            android:textSize="@dimen/texto_normal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/listaPropuestas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/espacio_medio"
                android:paddingStart="@dimen/espacio_pantalla"
                android:paddingTop="@dimen/espacio_medio"
                android:paddingEnd="@dimen/espacio_pantalla"
                android:paddingBottom="@dimen/espacio_pantalla" />

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/espacio_pantalla"
                android:text="@string/cargando"
                android:textColor="@color/gris"
                android:textSize="@dimen/texto_subtitulo" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
