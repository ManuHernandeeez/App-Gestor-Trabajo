<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:orientation="vertical">

    <LinearLayout style="@style/BarraSuperior">

        <ImageButton
            android:id="@+id/btnVolver"
            style="@style/BotonIcono"
            android:contentDescription="@string/volver"
            android:onClick="volver"
            android:src="@drawable/ic_atras" />

        <TextView
            android:id="@+id/txtTituloBarra"
            style="@style/TituloBarra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/titulo_seguimiento" />

        <ImageButton
            android:id="@+id/btnActualizar"
            style="@style/BotonIcono"
            android:contentDescription="@string/actualizar"
            android:onClick="actualizar"
            android:src="@drawable/ic_refrescar" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_pantalla">

            <TextView
                android:id="@+id/txtCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/espacio_pantalla"
                android:text="@string/cargando"
                android:textColor="@color/gris"
                android:textSize="@dimen/texto_subtitulo" />

            <LinearLayout
                android:id="@+id/vistaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_tarjeta">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtTitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espacio_pequeno"
                            android:layout_weight="1"
                            android:textColor="@color/texto"
                            android:textSize="@dimen/texto_titulo"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtEstado"
                            style="@style/EtiquetaEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtZona"
                        style="@style/FilaIcono"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:drawableStart="@drawable/ic_fila_ubicacion" />

                    <TextView
                        android:id="@+id/txtOtraParte"
                        style="@style/FilaIcono"
                        android:drawableStart="@drawable/ic_fila_persona" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtIndicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio"
                    android:background="@drawable/fondo_aviso"
                    android:padding="@dimen/espacio_medio"
                    android:textColor="@color/aviso_texto"
                    android:textSize="@dimen/texto_normal" />

                <LinearLayout
                    android:id="@+id/vistaContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio"
                    android:background="@drawable/fondo_tarjeta"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_tarjeta"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtContactoTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtContactoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo" />

                    <TextView
                        android:id="@+id/txtContactoTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo" />

                    <TextView
                        android:id="@+id/txtContactoDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/texto"
                        android:textSize="@dimen/texto_subtitulo" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnEnProceso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_seccion"
                    android:onClick="marcarEnProceso"
                    android:text="@string/boton_marcar_en_proceso"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnFinalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_seccion"
                    android:onClick="confirmarTerminado"
                    android:text="@string/boton_confirmar_terminado"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnCalificar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_seccion"
                    android:onClick="calificar"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
