<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/superficie"
    android:orientation="vertical">

    <LinearLayout style="@style/BarraSuperior">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_pequeno"
            android:paddingBottom="@dimen/espacio_pequeno">

            <TextView
                android:id="@+id/txtTitulo"
                style="@style/TituloBarra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_trabajos" />

            <TextView
                android:id="@+id/txtNombre"
                style="@style/SubtituloBarra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnActualizar"
            style="@style/BotonIcono"
            android:contentDescription="@string/actualizar"
            android:onClick="actualizar"
            android:src="@drawable/ic_refrescar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filtroOficio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/espacio_pantalla"
                android:paddingTop="@dimen/espacio_medio"
                android:paddingEnd="@dimen/espacio_pantalla"
                app:chipSpacingHorizontal="@dimen/espacio_pequeno"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/listaTrabajos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/espacio_medio"
                android:paddingStart="@dimen/espacio_pantalla"
                android:paddingTop="@dimen/espacio_medio"
                android:paddingEnd="@dimen/espacio_pantalla"
                android:paddingBottom="@dimen/espacio_pantalla" />

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="@dimen/espacio_pantalla"
                android:text="@string/cargando"
                android:textColor="@color/gris"
                android:textSize="@dimen/texto_subtitulo" />
        </FrameLayout>

        <include layout="@layout/barra_trabajador" />
    </LinearLayout>
</LinearLayout>
