<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de un catálogo del administrador: nombre, flecha si abre un nivel, lápiz e interruptor activo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_tarjeta"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/espacio_tarjeta"
    android:paddingEnd="@dimen/espacio_pequeno">

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/texto_subtitulo"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgAbrir"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_abrir"
        app:tint="@color/gris" />

    <ImageButton
        android:id="@+id/btnEditar"
        style="@style/BotonIcono"
        android:contentDescription="@string/editar"
        android:src="@drawable/ic_editar" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/interruptor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/activo" />
</LinearLayout>
