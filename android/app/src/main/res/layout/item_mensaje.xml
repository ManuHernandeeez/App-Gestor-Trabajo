<?xml version="1.0" encoding="utf-8"?>
<!-- Una burbuja con su hora. AdaptadorMensajes la alinea a la derecha o a la izquierda -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTexto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:paddingStart="14dp"
        android:paddingTop="@dimen/espacio_pequeno"
        android:paddingEnd="14dp"
        android:paddingBottom="@dimen/espacio_pequeno"
        android:textIsSelectable="false"
        android:textSize="@dimen/texto_subtitulo" />

    <TextView
        android:id="@+id/txtHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:textColor="@color/gris"
        android:textSize="@dimen/texto_pequeno" />
</LinearLayout>
