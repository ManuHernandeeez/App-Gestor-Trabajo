<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una propuesta para el cliente: quién la hace, su calificación, el precio destacado, el chat con el
     trabajador para ultimar detalles y la decisión -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_tarjeta"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:padding="@dimen/espacio_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtInicial"
            android:layout_width="@dimen/avatar"
            android:layout_height="@dimen/avatar"
            android:background="@drawable/fondo_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/principal"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_marginEnd="@dimen/espacio_pequeno"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTrabajador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="@dimen/texto_subtitulo"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/vistaEstrellas"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressBackgroundTint="@color/borde_campo"
                    android:progressTint="@color/alerta"
                    android:secondaryProgressTint="@color/alerta"
                    android:stepSize="0.1" />

                <TextView
                    android:id="@+id/txtCalificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/gris"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtEstado"
            style="@style/EtiquetaEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_medio"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_medio"
        android:background="@drawable/fondo_precio"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_medio">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/precio_propuesto"
            android:textColor="@color/principal_oscuro"
            android:textSize="@dimen/texto_normal" />

        <TextView
            android:id="@+id/txtPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/principal_oscuro"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnChatear"
        style="@style/BotonContorno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_medio"
        android:minHeight="48dp" />

    <LinearLayout
        android:id="@+id/vistaBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_medio"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRechazar"
            style="@style/BotonPeligro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_pequeno"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/boton_rechazar" />

        <Button
            android:id="@+id/btnAceptar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_pequeno"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/boton_aceptar" />
    </LinearLayout>
</LinearLayout>
