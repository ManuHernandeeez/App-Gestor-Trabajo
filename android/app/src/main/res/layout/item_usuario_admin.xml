<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de un usuario para el administrador: quién es, su rol y estado, y el botón para suspender o reactivar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_tarjeta"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espacio_tarjeta">

    <TextView
        android:id="@+id/txtInicial"
        android:layout_width="@dimen/avatar"
        android:layout_height="@dimen/avatar"
        android:background="@drawable/fondo_avatar"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/principal"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_medio"
        android:layout_marginEnd="@dimen/espacio_pequeno"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto"
            android:textSize="@dimen/texto_subtitulo"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_pequeno"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtRol"
                style="@style/EtiquetaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtEstado"
                style="@style/EtiquetaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_pequeno" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnEstado"
        style="@style/BotonContorno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="44dp" />
</LinearLayout>
