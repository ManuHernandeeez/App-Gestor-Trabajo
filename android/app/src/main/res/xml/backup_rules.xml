<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo automático de Android 11 y anteriores. La sesión (el token) no se respalda: es una credencial
    y la app no guarda ningún otro dato que valga la pena restaurar.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sesion.xml" />
</full-backup-content>
