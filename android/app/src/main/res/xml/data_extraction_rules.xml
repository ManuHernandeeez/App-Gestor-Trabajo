<?xml version="1.0" encoding="utf-8"?>
<!--
    Respaldo en la nube y copia a otro teléfono en Android 12 y posteriores. La sesión (el token) no se copia:
    es una credencial y quien cambia de teléfono debe iniciar sesión de nuevo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion.xml" />
    </device-transfer>
</data-extraction-rules>
